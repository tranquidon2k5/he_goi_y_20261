# Sao chép thành backend/.env rồi sửa.

# SQLite (mặc định) hoặc Postgres từ docker-compose:
# CINEREC_DATABASE_URL=postgresql+psycopg://cinerec:cinerec@localhost:5432/cinerec
CINEREC_DATABASE_URL=sqlite:///./cinerec.db

# Bắt buộc đổi khi triển khai thật (>= 32 ký tự)
CINEREC_JWT_SECRET=dev-only-secret-change-me-in-production-0000
CINEREC_COOKIE_SECURE=false

# Email đăng ký bằng các địa chỉ này sẽ có quyền admin (vào trang Lab)
CINEREC_ADMIN_EMAILS=admin@cinerec.vn

# TMDB: API key v3 hoặc Read Access Token v4 — dùng cho scripts/enrich_tmdb.py
CINEREC_TMDB_API_KEY=

# Cold-start: dưới ngưỡng này người dùng nhận "Thịnh hành" theo thể loại
CINEREC_COLD_START_THRESHOLD=5
